  "rig": {
    "referenceImages": [
      "assets/moves/rig-bones.png",
      "assets/moves/rig-muscles.png"
    ],
    "convention": "side view facing right; +X = forward, +Y = up; character origin at hips",
    "bones": [
      {
        "name": "hips",
        "parent": null,
        "role": "root bone",
        "notes": "controls body position + rotation; every movement starts here"
      },
      {
        "name": "spine",
        "parent": "hips",
        "role": "torso lean"
      },
      {
        "name": "chest",
        "parent": "spine",
        "role": "counter-rotation vs hips on runs and swings"
      },
      {
        "name": "neck",
        "parent": "chest",
        "role": "subtle head anticipation"
      },
      {
        "name": "head",
        "parent": "neck",
        "role": "KEEP RIGID",
        "notes": "mask must never deform; lead rotation with the chin"
      },
      {
        "name": "shoulder.L/.R",
        "parent": "chest",
        "role": "clavicle shrug/roll before arm swings"
      },
      {
        "name": "upperArm.L/.R",
        "parent": "shoulder",
        "role": "arm swing",
        "notes": "hinge at elbow only"
      },
      {
        "name": "forearm.L/.R",
        "parent": "upperArm",
        "role": "elbow bend",
        "notes": "one axis — elbows never bend backwards"
      },
      {
        "name": "hand.L/.R",
        "parent": "forearm",
        "role": "weapon socket parent",
        "notes": "grip pose baked per weapon"
      },
      {
        "name": "thigh.L/.R",
        "parent": "hips",
        "role": "run cycle driver",
        "notes": "knees bend backwards only"
      },
      {
        "name": "shin.L/.R",
        "parent": "thigh",
        "role": "knee bend"
      },
      {
        "name": "foot.L/.R",
        "parent": "shin",
        "role": "toe pivot on push-off, heel plant on landings"
      },
      {
        "name": "scarf.1/.2/.3",
        "parent": "neck",
        "role": "physics chain",
        "notes": "always lags motion by 2-3 frames, never leads"
      },
      {
        "name": "coatHem",
        "parent": "hips",
        "role": "sway bone",
        "notes": "1-2 bones, secondary motion"
      },
      {
        "name": "sheath",
        "parent": "hips",
        "role": "static socket",
        "notes": "back hip, katana parks here when sheathed"
      },
      {
        "name": "drone",
        "parent": null,
        "role": "independent",
        "notes": "orbits character, follows with delay"
      }
    ],
    "weaponSockets": {
      "katana": "hand.R (grip just below guard)",
      "revolver.L": "hand.L",
      "revolver.R": "hand.R",
      "sheathedKatana": "sheath bone on hips",
      "grappleWire": "left forearm gauntlet"
    },
    "animationPrinciples": [
      "Bend at joints, never mid-bone — bones are rigid segments",
      "Hips lead, then chest, then head — 1-2 frame delay per chain link gives follow-through",
      "Counter-rotate chest against hips for run cycles and heavy swings",
      "Anticipate every strike: wind opposite to the swing direction first",
      "Scarf and coat are physics-driven lag — they settle AFTER the body stops",
      "Slash arcs spawn along the katana blade's swept path, not on the body",
      "Keep the head/mask rigid and stable so the silhouette stays readable",
      "Feet: rolling contact — heel strike, flat, toe push-off"
    ]
  }
}